material m_Main {
    technique {
        pass {
            lighting off
            texture_unit {
                texture t_Main.png
                tex_address_mode wrap
                colour_op modulate
                filtering none
            }
        }
    }
}
material m_MetroFloor {
    technique {
        pass {
            lighting off
            texture_unit {
                texture t_MetroFloor.png
                tex_address_mode wrap
                colour_op modulate
                filtering none
            }
        }
    }
}

material m_Trans {
    technique {
        pass {
            lighting off
            scene_blend alpha_blend
            depth_write off
            texture_unit {
                texture t_Trans.png
                tex_address_mode wrap
                colour_op modulate
                filtering none
            }
        }
    }
}
material m_LCD
{
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                texture t_LCD.png
                tex_address_mode wrap
                colour_op modulate
                filtering none
                scroll_anim 0.2 0
            }
        }
    }
}